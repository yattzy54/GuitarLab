+                                ).show()
+                            } else {
+                                val s = minOf(cur.first, barNum)
+                                val e = maxOf(cur.first, barNum)
+                                loopRange = Pair(s, e)
+                                viewModel.setLoop(s - 1, e - 1)
+                                loopPickingPoint = "A"
+                                Toast.makeText(
+                                    context,
